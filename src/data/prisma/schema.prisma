  lines                      PurchaseInvoiceLine[]
  supplierCreditNotes        SupplierCreditNote[]
  supplierCreditApplications SupplierCreditNoteApplication[] @relation("SupplierCreditApplicationTarget")

  @@unique([entityId, invoiceNumber])
  @@unique([id, entityId])
  @@index([entityId, status, issueDate])
}

model WithholdingCertificate {
  id                  String                                @id @default(uuid())
  entityId            String
  entity              Entity                                @relation(fields: [entityId], references: [id], onDelete: Cascade)
  purchaseInvoiceId   String?
  purchaseInvoice     PurchaseInvoice?                      @relation(fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)
  cashflowPaymentId   String?
  cashflowPayment     CashflowPayment?                      @relation(fields: [cashflowPaymentId], references: [id], onDelete: SetNull)
  certificateNumber   String
  beneficiaryName     String
  beneficiaryFiscalId String?
  category            String
  grossAmountTtc      Float
  withholdingRate     Float
  withholdingAmount   Float
  currencyCode        String                                @default("TND")
  period              String
  sourceType          String
  sourceReference     String
  ruleSource          String
  ruleSourceDate      String?
  ruleEffectiveFrom   String?
  status              String                                @default("PREPARED")
  preparedByUserId    String
  preparedByUsername  String
  issuedByUserId      String?
  issuedByUsername    String?
  issuedAt            DateTime?
  cancelledByUserId   String?
  cancelledByUsername String?
  cancelledAt         DateTime?
  cancellationReason  String?
  revokedByUserId     String?
  revokedByUsername   String?
  revokedAt           DateTime?
  revocationReason    String?
  workflowEvents      WithholdingCertificateWorkflowEvent[]
  createdAt           DateTime                              @default(now())
  updatedAt           DateTime                              @updatedAt

