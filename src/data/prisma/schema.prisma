  @@unique([entityId, sourceType, sourceReference, category, period])
  @@index([entityId, status, period])
}

model WithholdingCertificateWorkflowEvent {
  id            String                 @id @default(uuid())
  certificateId String
  certificate   WithholdingCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  action        String
  actorUserId   String
  actorUsername String
