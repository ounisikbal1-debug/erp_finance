  applications           SupplierCreditNoteApplication[]
  createdAt              DateTime                          @default(now())
  updatedAt              DateTime                          @updatedAt

  @@unique([entityId, supplierDocumentNumber])
  @@unique([id, entityId])
  @@unique([sourceReturnId, entityId])
  @@index([entityId, status, createdAt])
  @@index([entityId, sourceInvoiceId])
}

model SupplierCreditNoteWorkflowEvent {
