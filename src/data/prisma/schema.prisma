  creditDate             DateTime?
  currencyCode           String
  functionalCurrencyCode String
  documentSubTotal       Float
  documentTaxAmount      Float
  documentTotalAmount    Float
  subTotal               Float
  taxAmount              Float
  totalAmount            Float
  taxRateId              String
  taxRateCode            String
  taxRate                Float
  exchangeRate           Float
  exchangeRateDate       DateTime?
  exchangeRateSource     String?
  exchangeRateImportedAt DateTime?
  status                 String                            @default("AWAITING_SUPPLIER_DOCUMENT")
  createdByUserId        String
  createdByUsername      String
  approvedByUserId       String?
  approvedByUsername     String?
  approvedAt             DateTime?
  postedByUserId         String?
  postedByUsername       String?
