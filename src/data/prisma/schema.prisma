model PurchaseInvoiceLine {
  id                  String                            @id @default(uuid())
  purchaseInvoiceId   String
  purchaseInvoice     PurchaseInvoice                   @relation(fields: [purchaseInvoiceId, entityId], references: [id, entityId], onDelete: Cascade)
