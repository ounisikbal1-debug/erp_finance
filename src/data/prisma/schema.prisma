  entity              Entity                            @relation(fields: [entityId], references: [id], onDelete: Cascade)
  description         String
  materialId          String?
  material            Material?                         @relation(fields: [materialId, entityId], references: [id, entityId], onDelete: Restrict)
  purchaseOrderLineId String?
  quantity            Float
  unitPrice           Float
  receiptMatches      PurchaseInvoiceLineReceiptMatch[]
  supplierCreditNotes SupplierCreditNote[]
  createdAt           DateTime                          @default(now())

  @@unique([id, purchaseInvoiceId, entityId])
  @@index([entityId, purchaseInvoiceId])
  @@index([entityId, materialId])
  @@index([entityId, purchaseOrderLineId])
