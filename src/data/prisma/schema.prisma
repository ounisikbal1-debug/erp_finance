model PurchaseOrderWorkflowEvent {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  action          String
  actorUserId     String
  actorUsername   String
  note            String
  createdAt       DateTime      @default(now())

  @@index([purchaseOrderId, action])
  @@index([purchaseOrderId, createdAt])
}

model PurchaseInvoiceLineReceiptMatch {
  id                String              @id @default(uuid())
  entityId          String
  purchaseInvoiceId String
  lineId            String
  receiptId         String              @unique
  line              PurchaseInvoiceLine @relation(fields: [lineId, purchaseInvoiceId, entityId], references: [id, purchaseInvoiceId, entityId], onDelete: Restrict)
  receipt           StockReceipt        @relation(fields: [receiptId, purchaseInvoiceId, entityId], references: [id, purchaseInvoiceId, entityId], onDelete: Cascade)
  createdAt         DateTime            @default(now())

  @@unique([receiptId, purchaseInvoiceId, entityId])
  @@index([entityId, purchaseInvoiceId, lineId])
}

model PurchaseInvoiceWorkflowEvent {
  id                String          @id @default(uuid())
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  action            String
  actorUserId       String
  actorUsername     String
  note              String
  createdAt         DateTime        @default(now())

  @@index([purchaseInvoiceId, action])
  @@index([purchaseInvoiceId, createdAt])
}

// ==========================================
// 7. VENTES & FACTURATION (Ventes et facturation SAFE)
// ==========================================

model Customer {
  id             String                  @id @default(uuid())
  code           String
  name           String
  fiscalId       String? // Matricule fiscal tunisien
  email          String?
  phone          String?
  address        String?
  entityId       String
  entity         Entity                  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  invoices       Invoice[]
  salesOrders    SalesOrder[]
  salesQuotes    SalesQuote[]
  contactChanges CustomerContactChange[]
  createdAt      DateTime                @default(now())

  @@unique([entityId, code])
  @@unique([entityId, id])
}

model CustomerContactChange {
  id            String   @id @default(uuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  field         String
  previousValue String?
  newValue      String?
  actorUserId   String
  actorUsername String
  createdAt     DateTime @default(now())

  @@index([customerId, createdAt])
}

model Invoice {
  id                     String                      @id @default(uuid())
  invoiceNumber          String                      @unique
  entityId               String
  entity                 Entity                      @relation(fields: [entityId], references: [id], onDelete: Cascade)
  customerId             String
  customer               Customer                    @relation(fields: [customerId], references: [id])
  currencyCode           String?
  vatAccountCode         String?
  subTotal               Float // Total Hors Taxe (HT)
  taxAmount              Float // Montant total TVA
  stampDuty              Float                       @default(1.000) // Droit de timbre
  totalAmount            Float // Total TTC Net à payer
  documentCurrencyCode   String?
  documentSubTotal       Float?
  documentTaxAmount      Float?
  documentStampDuty      Float?
  documentTotalAmount    Float?
  functionalCurrencyCode String?
  exchangeRate           Float?
  exchangeRateDate       DateTime?
  exchangeRateSource     String?
  exchangeRateImportedAt DateTime?
  dueDate                DateTime?
  status                 String                      @default("DRAFT") // DRAFT, ISSUED, PAID
  createdByUserId        String?
  createdByUsername      String?
  approvedByUserId       String?
  approvedByUsername     String?
  approvedAt             DateTime?
  issuedByUserId         String?
  issuedByUsername       String?
  issuedAt               DateTime?
  postingJournalEntryId  String?                     @unique
  workflowEvents         SalesInvoiceWorkflowEvent[]
  items                  InvoiceItem[]
  cashflowPayments       CashflowPayment[]
  quoteConversion        SalesQuoteConversion?
  salesOrderLink         SalesOrderInvoiceLink?
  createdAt              DateTime                    @default(now())
  fxRevaluationItems     FxRevaluationItem[]
  tunisianEInvoice       TunisianEInvoice?

  @@unique([id, entityId])
}

model SalesInvoiceWorkflowEvent {
  id            String   @id @default(uuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  action        String
  actorUserId   String
  actorUsername String
  note          String
  createdAt     DateTime @default(now())

  @@index([invoiceId, action])
  @@index([invoiceId, createdAt])
}

model InvoiceItem {
  id          String    @id @default(uuid())
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  materialId  String?
  material    Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  description String
  quantity    Float     @default(1)
  unitPrice   Float
  taxRate     Float     @default(19.0) // TVA 19%, 13%, 7%
  totalAmount Float

  @@index([materialId])
}

model SalesOrder {
  id                String                   @id @default(uuid())
  orderNumber       String                   @unique
  entityId          String
  entity            Entity                   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer                 @relation(fields: [customerId], references: [id])
  currencyCode      String
  totalAmount       Float
  status            String                   @default("OPEN") // OPEN, PICKED, DISPATCHED, CANCELLED
  lines             SalesOrderLine[]
  stockPickLink     SalesOrderStockPickLink?
  createdByUserId   String
  createdByUsername String
  createdAt         DateTime                 @default(now())
  invoiceLink       SalesOrderInvoiceLink?
  quoteConversion   SalesQuoteOrderConversion?

  @@unique([id, entityId])
  @@index([entityId, status, createdAt])
}

model SalesOrderLine {
  id          String     @id @default(uuid())
  entityId    String
  entity      Entity     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  orderId     String
  order       SalesOrder @relation(fields: [orderId, entityId], references: [id, entityId], onDelete: Cascade)
  materialId  String
  material    Material   @relation(fields: [materialId, entityId], references: [id, entityId], onDelete: Restrict)
  description String
  quantity    Float
  unitPrice   Float
  totalAmount Float
  createdAt   DateTime   @default(now())

  @@unique([id, entityId])
  @@index([entityId, orderId])
  @@index([entityId, materialId])
}

model SalesOrderStockPickLink {
  id           String     @id @default(uuid())
  entityId     String
  entity       Entity     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId, entityId], references: [id, entityId], onDelete: Cascade)
  stockPickId  String
  stockPick    StockPick  @relation(fields: [stockPickId, entityId], references: [id, entityId], onDelete: Restrict)
  createdAt    DateTime   @default(now())

  @@unique([salesOrderId, entityId])
  @@unique([stockPickId, entityId])
}

model SalesOrderInvoiceLink {
  id                String     @id @default(uuid())
  entityId          String
  entity            Entity     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  salesOrderId      String
  salesOrder        SalesOrder @relation(fields: [salesOrderId, entityId], references: [id, entityId], onDelete: Restrict)
  invoiceId         String
  invoice           Invoice    @relation(fields: [invoiceId, entityId], references: [id, entityId], onDelete: Restrict)
  createdByUserId   String
  createdByUsername String
  createdAt         DateTime   @default(now())

  @@unique([salesOrderId, entityId])
  @@unique([invoiceId, entityId])
  @@index([entityId, createdAt])
}

model SalesQuote {
  id                String                @id @default(uuid())
  quoteNumber       String
  entityId          String
  entity            Entity                @relation(fields: [entityId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer              @relation(fields: [entityId, customerId], references: [entityId, id], onDelete: Restrict)
  currencyCode      String
  subTotal          Float
  taxAmount         Float
  totalAmount       Float
  status            String                @default("DRAFT")
  createdByUserId   String
  createdByUsername String
  createdAt         DateTime              @default(now())
  items             SalesQuoteItem[]
  conversion        SalesQuoteConversion?
  orderConversion   SalesQuoteOrderConversion?

  @@unique([entityId, quoteNumber])
  @@unique([id, entityId])
  @@index([entityId, createdAt])
  @@index([customerId])
}

model SalesQuoteItem {
  id          String     @id @default(uuid())
  quoteId     String
  quote       SalesQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position    Int
  description String
  quantity    Float
  unitPrice   Float
  taxRate     Float
  totalAmount Float

  @@unique([quoteId, position])
}

model SalesQuoteConversion {
  id                  String     @id @default(uuid())
  quoteId             String     @unique
  quote               SalesQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  invoiceId           String     @unique
  invoice             Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  entityId            String
  convertedByUserId   String
  convertedByUsername String
  acceptanceNote      String
  createdAt           DateTime   @default(now())

  @@index([entityId, createdAt])
}

model SalesQuoteOrderConversion {
  id                  String     @id @default(uuid())
  quoteId             String
  quote               SalesQuote @relation(fields: [quoteId, entityId], references: [id, entityId], onDelete: Restrict)
  salesOrderId        String
  salesOrder          SalesOrder @relation(fields: [salesOrderId, entityId], references: [id, entityId], onDelete: Restrict)
  entityId            String
  entity              Entity     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  convertedByUserId   String
  convertedByUsername String
  acceptanceNote      String
  createdAt           DateTime   @default(now())

  @@unique([quoteId, entityId])
  @@unique([salesOrderId, entityId])
  @@index([entityId, createdAt])
}

model MonthlyCloseChecklistEvent {
  id            String   @id @default(uuid())
  entityId      String
  entity        Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  period        String
  checkKey      String
  checked       Boolean
  note          String
  actorUserId   String
  actorUsername String
  createdAt     DateTime @default(now())

  @@index([entityId, period, createdAt])
  @@index([entityId, period, checkKey, createdAt])
}

model MonthlyCloseLock {
  id            String   @id @default(uuid())
  entityId      String
  entity        Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  period        String
  note          String
  actorUserId   String
  actorUsername String
  lockedAt      DateTime @default(now())

  @@unique([entityId, period])
  @@index([entityId, lockedAt])
}

model Equipment {
  id                          String                        @id @default(uuid())
  entityId                    String
  entity                      Entity                        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  assetTag                    String
  name                        String
  category                    String
  location                    String?
  status                      String                        @default("ACTIVE")
  isVehicle                   Boolean                       @default(false)
  vehicleRegistrationNumber   String?
  vehicleOdometerKm           Int?
  vehicleFuelType             String?
  vehicleInsuranceExpiry      DateTime?
  vehicleNextServiceAt        DateTime?
  vehicleNextServiceOdometerKm Int?
  vehicleAssignment            EquipmentVehicleAssignment?
  workOrders                  MaintenanceWorkOrder[]
  qualityFindings             QualityFinding[]
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt

  @@unique([id, entityId])
  @@unique([entityId, assetTag])
  @@unique([entityId, vehicleRegistrationNumber])
  @@index([entityId, status, name])
  @@index([entityId, isVehicle, vehicleNextServiceAt], map: "vehicle_due_date_idx")
  @@index([entityId, isVehicle, vehicleNextServiceOdometerKm], map: "vehicle_due_odometer_idx")
}

model EquipmentVehicleAssignment {
  id          String    @id @default(uuid())
  entityId    String
  entity      Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId, entityId], references: [id, entityId], onDelete: Cascade)
  employeeId  String
  employee    Employee  @relation(fields: [employeeId, entityId], references: [id, entityId], onDelete: Restrict)
  assignedAt  DateTime  @default(now())

  @@unique([equipmentId, entityId])
  @@index([entityId, employeeId])
}

model MaintenanceWorkOrder {
  id                       String    @id @default(uuid())
  entityId                 String
  entity                   Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  equipmentId              String
  equipment                Equipment @relation(fields: [equipmentId, entityId], references: [id, entityId], onDelete: Restrict)
  type                     String
  description              String
  scheduledAt              DateTime
  status                   String    @default("PLANNED")
  completedAt              DateTime?
  actualCost               Float?
  actualCostCurrencyCode   String?
  completionOdometerKm     Int?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([entityId, status, scheduledAt])
  @@index([equipmentId, scheduledAt])
}

model QualityFinding {
  id                String          @id @default(uuid())
  entityId          String
  entity            Entity          @relation(fields: [entityId], references: [id], onDelete: Cascade)
  equipmentId       String?
  equipment         Equipment?      @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  title             String
  description       String
  source            String
  severity          String
  status            String          @default("OPEN")
  detectedAt        DateTime
  dueAt             DateTime?
  owner             String
  rootCause         String?
  containmentAction String?
  closureNotes      String?
  actions           QualityAction[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([entityId, status, severity, dueAt])
  @@index([equipmentId, createdAt])
}

model QualityAction {
  id                String         @id @default(uuid())
  findingId         String
  finding           QualityFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  type              String
  description       String
  owner             String
  dueAt             DateTime
  status            String         @default("OPEN")
  verificationNotes String?
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([findingId, status, dueAt])
}

model TunisianEInvoice {
  id              String    @id @default(uuid())
  invoiceId       String    @unique
  invoice         Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  entityId        String
  entity          Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  ttnReference    String?
  status          String    @default("GENERATED")
  xmlPayload      String
  sha256Hash      String
  qrCodeData      String
  signatureDigest String?
  submissionDate  DateTime?
  responseDate    DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([entityId])
  @@index([status])
}
