# SAFE ERP - Exemple de configuration d'environnement
PORT=3000
API_HOST=127.0.0.1
SAFE_ERP_DATABASE_PROVIDER=sqlite
SAFE_ERP_DATABASE_URL="file:../data.db"
# Generate a unique value with: node -e "process.stdout.write(require('node:crypto').randomBytes(48).toString('base64'))"
SAFE_ERP_AUTH_SECRET=
SAFE_ERP_FX_DAILY_IMPORT_ENABLED=false
NODE_ENV=production
